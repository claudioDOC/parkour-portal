{
  "expo": {
    "name": "Parkour Portal",
    "slug": "parkour-portal",
    "version": "1.7.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "parkourportal",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0d0d0f",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "org.duckdns.matetraining.app",
      "versionCode": 8,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0d0d0f",
          "image": "./assets/images/icon.png",
          "imageWidth": 120,
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store",
      "@maplibre/maplibre-react-native",
      "./plugins/withKotlinJvmTarget.js",
      "./plugins/withLauncherIcons.js"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "updates": {
      "enabled": true,
      "url": "https://matetraining.duckdns.org/api/expo/manifest",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 3000
    },
    "runtimeVersion": "1.1.0",
    "ios": {
      "bundleIdentifier": "org.duckdns.matetraining.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Für „Bin da\" und den Standort beim Spot-Anlegen.",
        "NSPhotoLibraryUsageDescription": "Damit du Fotos zu Spots und Challenges hinzufügen kannst.",
        "NSCameraUsageDescription": "Damit du Fotos direkt aufnehmen kannst."
      }
    }
  }
}