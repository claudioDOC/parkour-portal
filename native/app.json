{
  "expo": {
    "name": "Parkour Portal",
    "slug": "parkour-portal",
    "version": "1.5.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "parkourportal",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0d0d0f",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "org.duckdns.matetraining.app",
      "versionCode": 6,
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0d0d0f",
          "image": "./assets/images/icon.png",
          "imageWidth": 120,
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store",
      "@maplibre/maplibre-react-native",
      [
        "expo-dynamic-app-icon",
        {
          "terracotta": {
            "image": "./assets/images/icons/icon-terracotta.png",
            "prerendered": true
          },
          "neon": {
            "image": "./assets/images/icons/icon-neon.png",
            "prerendered": true
          },
          "tuerkis": {
            "image": "./assets/images/icons/icon-tuerkis.png",
            "prerendered": true
          },
          "violett": {
            "image": "./assets/images/icons/icon-violett.png",
            "prerendered": true
          },
          "rot": {
            "image": "./assets/images/icons/icon-rot.png",
            "prerendered": true
          },
          "blau": {
            "image": "./assets/images/icons/icon-blau.png",
            "prerendered": true
          }
        }
      ],
      "./plugins/withKotlinJvmTarget.js"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "updates": {
      "enabled": true,
      "url": "https://matetraining.duckdns.org/api/expo/manifest",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 3000
    },
    "runtimeVersion": "1.1.0"
  }
}